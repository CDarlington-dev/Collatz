/-- Every individual start in the strict finite seed interval passed its block. -/
theorem firstExcursionAt_true {x : ℕ} (hx : x < 113383) :
    firstExcursionAt x = true := by
  let b := x / 1000
  have hb : b ≤ 113 := by
    dsimp [b]
    omega
  have hblock := firstExcursionAllBlocks_true b hb
  have hlo : 1000 * b ≤ x := by
    have h := Nat.div_mul_le_self x 1000
    simpa [b, Nat.mul_comm] using h
  apply firstExcursionIntervalCheck_sound hblock hlo
  dsimp [firstExcursionBlockCheck] at hblock
  by_cases hlast : b = 113
  · simp [hlast]
    omega
  · simp [hlast]
    have hmod : x % 1000 < 1000 := Nat.mod_lt x (by norm_num)
    have hdecomp : x / 1000 * 1000 + x % 1000 = x :=
      by simpa [Nat.mul_comm] using Nat.div_add_mod x 1000
    dsimp [b]
    omega

/--
The first inverse-excursion envelope, with every finite acceptance equality
reduced by Lean's kernel rather than by `native_decide`.
-/
theorem firstExcursionEnvelope_kernel :
    AcceleratedExcursionEnvelope 1000000000 113383 := by
  intro x hx r
  by_cases hxzero : x = 0
  · subst x
    rw [endpoint_zero_all]
    norm_num
  · have hxat := firstExcursionAt_true hx
    have hxcheck : orbitCheck 1000000000 223 x = true := by
      simpa [firstExcursionAt, hxzero] using hxat
    obtain ⟨d, hd, hone, hprefix⟩ := orbitCheck_sound hxcheck
    by_cases hrd : r ≤ d
    · exact hprefix r hrd
    · have hdr : d ≤ r := by omega
      calc
        endpoint x r = endpoint x (d + (r - d)) := by
          rw [Nat.add_sub_of_le hdr]
        _ = endpoint (endpoint x d) (r - d) := endpoint_add x d (r - d)
        _ = endpoint 1 (r - d) := by rw [hone]
        _ ≤ 2 := (endpoint_one_two_cycle_le_two (r - d)).1
        _ < 1000000000 := by norm_num

/-- The strict seed is exact, using a separate kernel-reduced boundary orbit. -/
theorem firstExcursionSeedExact_kernel :
    AcceleratedExcursionEnvelope 1000000000 113383 ∧
      1000000000 ≤ endpoint 113383 69 := by
  exact ⟨firstExcursionEnvelope_kernel,
    by rw [endpoint_113383_69]; norm_num⟩

